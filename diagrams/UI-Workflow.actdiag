actdiag {
  browse -> select -> send -> mix -> control
  control -> status -> update -> take

  lane user {
    label = "User"
    browse [label = "Browse Cocktail List"];
    select [label = "Select Cocktail"];
    take [label = "Cheers!"];
  }
  lane ui {
    label = "JiggerU"
    send [label = "Send Recipe"];
    update
  }
  lane hal{
    label = "HAL implementation"
    mix [label = "Get Request"];
    status
  }
  lane hardware {
    label = "Miximus Prime"
    control [label = "Control Hardware"];
  }
}
